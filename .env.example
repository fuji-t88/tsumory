# プロジェクト直下の .env のひな形。.env にコピーして使う（.env はコミットしない）。
# .env は、docker compose（compose.yaml の値の差し込み）と、開発時の Spring Boot（spring.config.import）の両方が読む。
# 値を引用符で囲まない（Spring Boot がプロパティファイルとして読み、引用符も値に含まれてしまう）。

# Claude API のキー。初期値はない（bootRun でも、docker compose --profile deploy のアプリでも要る）
ANTHROPIC_API_KEY=

# DB の接続情報。書かなければ初期値（DB 名・ユーザー名 tsumory、パスワード secret）
# POSTGRES_DB=tsumory
# POSTGRES_USER=tsumory
# POSTGRES_PASSWORD=secret
